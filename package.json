{
  "name": "product-10k-sales-dashboard-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- next dev",
    "dev:clean": "rm -rf .next node_modules/.cache && dotenv -e .env -- next dev",
    "build": "next build",
    "build:dev": "dotenv -e .env.development -- next build",
    "build:prod": "dotenv -e .env.production -- npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "build:cf": "npm run build:prod",
    "preview:cf": "npm run build:cf && npx wrangler pages dev .vercel/output/static",
    "deploy:cf": "npm run build:cf && npx wrangler pages deploy .vercel/output/static --project-name=dev-salse-dashbord"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",

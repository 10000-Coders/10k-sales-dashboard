    "@tailwindcss/typography": "^0.5.19",
    "axios": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "firebase": "^10.8.0",
    "firestore": "^1.1.6",
    "katex": "^0.16.44",
    "lucide-react": "^0.575.0",
